# Database
# Local demo (SQLite). Production: postgresql://user:pass@host:5432/servc
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
OTP_EXPIRY_MINUTES="10"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ServC Auto India"

# Payments (Razorpay) — use test keys for demo
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="xxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxx"

# WhatsApp Business API (Meta Cloud API) — optional for demo
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_MOCK="true"

# SMS OTP provider (MSG91 / Twilio) — mock in demo
OTP_MOCK="true"
SMS_API_KEY=""
